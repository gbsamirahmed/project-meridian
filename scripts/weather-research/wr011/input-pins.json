  "comparison_predeclaration": {
    "before_values": true,
    "packing": "Actual template5.42 CCSDS: integer domain<2**24, D0, binary scaling; inspected GDAL3.9.3 aecunpack.c float32 multiply/add profile. Require all secondary cells exactly equal predicted binary32 native values AND per-cell half-ULP multiply/add bound plus float64 guard. No observed-value-based tolerance adjustment.",
    "packing_source_expression": "refD + bdscale*(g2float)ifld; for actual D0 binary scaling exact, only final float32 addition can round; require exact predicted expression plus half-ULP sum bound and float64 guard.",
    "precipitation_units": "GDAL3.9.3 reports unknown parameter/unit for ECMWF local0/1/193; compare numerical arrays and rawPDT independently, use primary producer definitions centre98/localtable1/paramId228 for metre depth. No independent GDAL physical-unit vocabulary confirmation for this one field.",
    "source_inspection_confirmed_utc": "2026-10-10T18:13:16.864569+00:00",
    "spatial": "Use actual ECMWF origin180 periodic native column order; cannot call WR008 Grid with origin0. New finite shifted-regular-grid geometry adapter preserves storage. Independent GDAL affine uses unwrapped centres180..539.75; longitude labels modulo360 only; exact query nodes/weights checked with GDAL decoded arrays, no claim of independent GDAL warp.",
    "temporal": "PDT8 exact metadata/raw endtime: forecastTime0h, end24h duration24h stataccum1, time increment450s/type2. Strict WR009 implementation rejects this; new finite support interpreter retains increment450s and does not infer internal step count or endpoint convention.",
    "utc": "2026-10-10T18:10:56.672992+00:00"
  },
